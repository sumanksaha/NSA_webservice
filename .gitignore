evaluation/test_*.py
evaluation/evaluate_relabel_truth.py
evaluation/verify_relabel_claims.py
evaluation/concept_gate_reachability.py
evaluation/answer_quality_headroom.py

# Modules that committed tests import must stay tracked, even when their name
# matches an ignore pattern above. tests/test_compare_rerun_arms.py imports
# evaluation.compare_rerun_arms; with it ignored, the module is absent from a
# fresh clone and the whole test shard dies at collection (ModuleNotFoundError).
!evaluation/compare_rerun_arms.py

evaluation/out/

# Script debug / probe scripts (temporary investigation tools)
scripts/_*.py
smoke_test.py

# Test-run output artifacts
pytest.out.txt
.coverage
coverage.xml
htmlcov/
nul
*.db
instance/app.db
instance/app.db.backup_*
piolium/tmp/

