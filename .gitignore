# Machine Learning / AI
# ---------------------------------------------------------------------------
*.model
*.pkl
*.h5
*.hdf5
*.pb
embeddings/
vector-store/
/models/           # ML model-weight directory (root-level only — anchored so it never matches app/models/).
                   # app/models/ (the SQLAlchemy models package) is intentionally NOT ignored here.

weights/
checkpoints/

# ---------------------------------------------------------------------------
# Celery / Task Queue
# ---------------------------------------------------------------------------
celerybeat-schedule*
celerybeat.pid
celeryd.pid
*.celery

