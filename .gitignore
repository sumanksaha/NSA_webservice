# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
*.egg-info/
.eggs/
*.so
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
*.cover
*.py,cover
.mypy_cache/
.ruff_cache/
.hypothesis/
perf.data*
*.prof

# ---------------------------------------------------------------------------
# Virtual Environments
# ---------------------------------------------------------------------------
venv/
.venv/
env/
.env/
.venv_*/
env_*/
virtualenv/
virtualenv_*/
ve/
.ve/

