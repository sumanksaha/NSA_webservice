# ---------------------------------------------------------------------------
instance/instance/
*.backup_*
*_backup.csv
smoke_test.py
nul
*.db
instance/app.db
instance/app.db.backup_*
piolium/tmp/

# ---------------------------------------------------------------------------
# Local Data / Generated CSV Data (use data/ dir for essential copies)
# ---------------------------------------------------------------------------
*.csv
!tests/fixtures/*.csv
!.gitignore

