# .gitattributes - Enterprise Line Ending Configuration
# For Python/FastAPI projects deployed on Linux
# Generated: 2026
#
# NOTE: text rules deliberately do NOT set -diff.  Suppressing the diff
# driver makes git treat ordinary text files as binary (no diffs, no
# inline conflict markers on merge), which breaks reviews and conflict
# resolution.  Only real binaries (below) and Git LFS files set -diff.
# =============================================================================
# DEFAULT: Use LF for all text files (Linux-standard)
# =============================================================================
* text=auto eol=lf
# =============================================================================
# PYTHON FILES - CRITICAL: Always LF
# Must be LF for Python to work correctly on Linux deployment
# =============================================================================
*.py text eol=lf diff=python
# =============================================================================
# SHELL SCRIPTS - CRITICAL: Always LF
# Shell scripts must have LF for Linux/macOS compatibility
# =============================================================================
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
*.fish text eol=lf
*.csh text eol=lf
*.ksh text eol=lf
# =============================================================================
# WINDOWS BATCH FILES - Keep CRLF
# Windows-specific files that require CRLF to function
# =============================================================================
*.bat text eol=crlf
*.cmd text eol=crlf
# =============================================================================
# POWERSHELL SCRIPTS - Windows-native, allow native line endings
# =============================================================================
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
# =============================================================================
# CONFIGURATION FILES - LF
# =============================================================================
*.json text eol=lf
*.jsonc text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
*.config text eol=lf
# =============================================================================
# MARKUP AND WEB FILES - LF
# =============================================================================
*.md text eol=lf
*.markdown text eol=lf
*.html text eol=lf
*.htm text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.sass text eol=lf
