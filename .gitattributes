# .gitattributes - Enterprise Line Ending Configuration
# For Python/FastAPI projects deployed on Linux
# Generated: 2026
# =============================================================================
# DEFAULT: Use LF for all text files (Linux-standard)
# =============================================================================
* text=auto eol=lf
# =============================================================================
# PYTHON FILES - CRITICAL: Always LF
# Must be LF for Python to work correctly on Linux deployment
# =============================================================================
*.py text eol=lf diff=python
*.pyc text eol=lf -diff
*.pyo text eol=lf -diff
*.pyd text eol=lf -diff
# =============================================================================
# SHELL SCRIPTS - CRITICAL: Always LF
# Shell scripts must have LF for Linux/macOS compatibility
# =============================================================================
*.sh text eol=lf -diff
*.bash text eol=lf -diff
*.zsh text eol=lf -diff
*.fish text eol=lf -diff
*.csh text eol=lf -diff
*.ksh text eol=lf -diff
# =============================================================================
# WINDOWS BATCH FILES - Keep CRLF
# Windows-specific files that require CRLF to function
# =============================================================================
*.bat text eol=crlf -diff
*.cmd text eol=crlf -diff
# =============================================================================
# POWERSHELL SCRIPTS - Windows-native, allow native line endings
# =============================================================================
*.ps1 text eol=crlf -diff
*.psm1 text eol=crlf -diff
*.psd1 text eol=crlf -diff
# =============================================================================
# CONFIGURATION FILES - LF
# =============================================================================
*.json text eol=lf -diff
*.jsonc text eol=lf -diff
*.yaml text eol=lf -diff
*.yml text eol=lf -diff
*.toml text eol=lf -diff
*.ini text eol=lf -diff
*.cfg text eol=lf -diff
*.conf text eol=lf -diff
*.config text eol=lf -diff
# =============================================================================
