# =============================================================================
# DATA AND DATABASE FILES - LF
# =============================================================================
*.sql text eol=lf
*.csv text eol=lf
*.tsv text eol=lf
# =============================================================================
# DOCUMENTATION - LF
# =============================================================================
*.txt text eol=lf
*.rst text eol=lf
*.tex text eol=lf
# =============================================================================
# BUILD AND CI FILES - LF
# =============================================================================
*.xml text eol=lf
Dockerfile text eol=lf
docker-compose.yml text eol=lf
docker-compose.yaml text eol=lf
Makefile text eol=lf
Rakefile text eol=lf
Jenkinsfile text eol=lf
*.gradle text eol=lf
# =============================================================================
# LICENSE AND LEGAL - LF
# =============================================================================
LICENSE text eol=lf
COPYING text eol=lf
# =============================================================================
# BINARY FILES - Never modify line endings
# The `binary` macro = -diff -merge -text, which is what we want here.
# =============================================================================
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.bz2 binary
*.7z binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.pyc binary
*.pyo binary
*.pyd binary
*.db binary
*.sqlite binary
*.sqlite3 binary
