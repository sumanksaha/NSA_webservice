@echo offREM =============================================================================REM Line Ending Conversion Script for WindowsREM Converts all existing files to LF as per .gitattributesREM Run this AFTER configuring Git (setup-git-line-endings.bat)REM =============================================================================echo ================================================================================echo Converting Line Endings to LFecho ================================================================================echo.echo [1/6] Removing cached files from Git index...git rm --cached -r .echo.echo [2/6] Re-normalizing line endings (this may take a while)...git reset --hardecho.echo [3/6] Configuring Git to use LF in working directory...git config core.autocrlf falseecho.echo [4/6] Re-adding all files with correct line endings...git add -Aecho.echo [5/6] Verifying no CRLF files remain (should show nothing)...git ls-files -z | xargs -0 file | findstr CRLFif %errorlevel% equ 0 (    echo WARNING: Some files still have CRLF. Please review above.) else (    echo SUCCESS: No CRLF files found!)echo.echo [6/6] Showing status of changes...git statusecho.echo ================================================================================echo Conversion Complete!echo ================================================================================echo.echo Next steps:echo 1. Review the changes: git diff --cachedecho 2. Commit the normalization: git commit -m "chore: normalize line endings to LF"echo 3. Push to remote: git pushecho.echo IMPORTANT: All teammates should also run scripts/setup-git-line-endings.batecho.pause