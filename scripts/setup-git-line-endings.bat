@echo offREM =============================================================================REM Git Line Ending Configuration Script for WindowsREM For Python/FastAPI projects deployed on LinuxREM Run this ONCE on each Windows developer machine after cloning the repoREM =============================================================================echo ================================================================================echo Git Line Ending Configuration for Enterprise Python/FastAPI Projectsecho ================================================================================echo.echo [1/5] Configuring Git global settings...REM Disable autocrlf globally - we use .gitattributes for per-repo controlgit config --global core.autocrlf falseREM Enable safecrlf to prevent accidental committing of mixed line endingsgit config --global core.safecrlf trueREM Disable autocrlf in input (legacy safety)git config --global core.autocrlf.input falseecho.echo [2/5] Configuring Git line-ending diff algorithm...git config --global core.whitespace cr-at-eolecho.echo [3/5] Removing any existing file mode issues...git config --global core.filemode falseecho.echo [4/5] Setting up Git aliases for line-ending management...git config --global alias.le "!git log --pretty=format:'%%h - %%an [%%ar] - %%s' --name-status"git config --global alias.line-endings "!git ls-files -z | grep -z -v '^$' | xargs -0 file | grep CRLF"echo.echo [5/5] Verifying Git configuration...echo.echo Current Git configuration:echo ---------------------------git config --list | grep -E "core\.(autocrlf|safecrlf|filemode|whitespace)"echo.echo ================================================================================echo Configuration complete!echo ================================================================================echo.echo IMPORTANT NEXT STEPS:echo ---------------------echo 1. Re-clone this repository or run the conversion scriptecho 2. Run: scripts\convert-line-endings.batecho 3. Commit the changes: git commit -am "chore: normalize line endings to LF"echo 4. Verify no warnings appearecho.echo For teammates on other platforms, see: docs/LINE_ENDINGS_SETUP.mdecho.pause