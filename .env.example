# =============================================================================
# NSA Webservice — Environment Variable Reference
# =============================================================================
# Copy this file to .env and fill in your local development values.
# Never commit .env to version control.
#
# For Render production, set each variable via the Render Dashboard.
# See render.yaml for the base service definition.
# =============================================================================

# ---------------------------------------------------------------------------
# Flask
# ---------------------------------------------------------------------------
# Generate a secure random key:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret-key

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL (production): postgresql://user:password@host:5432/nsa_db
# SQLite   (local dev):    sqlite:////absolute/path/to/app.db  (or omit to use default)
DATABASE_URL=

# ---------------------------------------------------------------------------
# Redis / Celery
# ---------------------------------------------------------------------------
# Local dev default: redis://localhost:6379/0
# Render / production: rediss://user:password@host:6379
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Airtable Sync (Multi-Target Sheets Redundancy — Priority 7)
# ---------------------------------------------------------------------------
# Airtable personal access token from https://airtable.com/create/tokens
# Required scopes: data.records:write, data.records:read
# Optional (base rotation): schema.bases:read, schema.bases:write
AIRTABLE_API_KEY=your-airtable-personal-access-token-here

# Primary Airtable base ID (starts with "app" — find in airtable.com URL)
AIRTABLE_BASE_ID=your-airtable-base-id-here

# Feature flag — set to "true" to enable Airtable sync (app/services/airtable_sync.py).
# Set to "false" (or leave unset) to keep Airtable dormant.
ENABLE_AIRTABLE_SYNC=true

# ---------------------------------------------------------------------------
# Microsoft Excel Online Sync (Multi-Target Sheets Redundancy — Priority 7)
# ---------------------------------------------------------------------------
# Azure AD app registration (app-only / client credentials flow) with
# Files.ReadWrite.All application permission granted admin consent.
# Create at https://portal.azure.com → Azure Active Directory → App registrations.
MS_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MS_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MS_CLIENT_SECRET=your-client-secret-here
# The OneDrive/SharePoint drive item ID of the Excel workbook.
# Find via: https://graph.microsoft.com/v1.0/drives/{MS_DRIVE_ID}/root/children
MS_DRIVE_ID=
MS_SPREADSHEET_ID=your-excel-spreadsheet-id-here
# Feature flag — set to "true" once Microsoft 365 credentials are available.
# Currently dormant (ENABLE_EXCEL_SYNC=false) — MS Excel Online sync off.
ENABLE_EXCEL_SYNC=false

# ---------------------------------------------------------------------------
# Google Sheets Sync
# ---------------------------------------------------------------------------
# The full JSON content of the Google service-account credential file,
# pasted as a single-line or multi-line string (gspread parses it).
# Example:  GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":...}
GOOGLE_CREDENTIALS_JSON=

# The ID (long hex string) of the Google Spreadsheet to sync with.
SPREADSHEET_ID=

# ---------------------------------------------------------------------------
# S3-Compatible Storage (Cloudflare R2 / Backblaze B2)
# ---------------------------------------------------------------------------
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_ENDPOINT=

# Optional region override (defaults to 'auto' for R2)
R2_REGION=auto

# Optional custom public domain (e.g. https://media.example.com)
R2_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Cloudinary (photo upload & management)
# ---------------------------------------------------------------------------
# Credentials from https://console.cloudinary.com/  →  API Keys tab.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# The python-cloudinary SDK also accepts the combined form (optional):
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ---------------------------------------------------------------------------
# PDF Generation
# ---------------------------------------------------------------------------
# Set to 'true' to disable PDF generation (useful on systems without GTK)
DISABLE_PDF_GENERATION=false

# Set to 'true' to embed photo URLs directly instead of base64 data URIs
PDF_USE_DIRECT_URLS=false

# ---------------------------------------------------------------------------
# Upstash QStash (serverless task queue — no background worker required)
# ---------------------------------------------------------------------------
# QStash delivers task messages to your public webhook URL, so heavy work
# (PDF generation) can run without a persistent Celery worker.
# Get credentials from https://console.upstash.com/qstash
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Public base URL of this app (used to construct the webhook URL QStash POSTs to)
# e.g. https://food-adjudication-portal.onrender.com
PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Startup Behaviour
# ---------------------------------------------------------------------------
# Set to '1' to skip the FSO sync on startup (useful during fresh-DB migrations)
SKIP_FSO_STARTUP_SYNC=

# ---------------------------------------------------------------------------
# AI Assistant (Phase 11)
# ---------------------------------------------------------------------------
# LLM provider: 'openrouter' (default) or 'openai'.
# When unset or empty, the AI assistant is dormant (routes return 503).
AI_ASSISTANT_PROVIDER=openrouter

# API key for the selected provider.
# Get from https://openrouter.ai/ (API Keys) or https://platform.openai.com/ (API keys).
AI_ASSISTANT_API_KEY=

# Optional override for the API base URL (e.g. for a proxy or self-hosted model).
# Defaults to https://openrouter.ai/api/v1 or https://api.openai.com/v1.
AI_ASSISTANT_BASE_URL=

# Optional model override.
# Defaults to 'poolside/laguna-s-2.1:free' (OpenRouter) or 'gpt-4o-mini' (OpenAI).
AI_ASSISTANT_MODEL=

# ---------------------------------------------------------------------------
# Phase B: RAG (FSSAI Legal RAG System — Agent B)
# ---------------------------------------------------------------------------
# Set to 'false' to disable the RAG module entirely (routes return 503).
RAG_ENABLED=true

# LLM model for grounded RAG generation (Agent B Phase 2+).
# Defaults to 'poolside/laguna-s-2.1:free' (OpenRouter free tier).
# The RAG_LLM_MODEL env var overrides the default.
# Set to any OpenAI-compatible model slug.
RAG_LLM_MODEL=poolside/laguna-s-2.1:free

# API key for the LLM provider (OpenAI-compatible).
# Get from https://openrouter.ai/ (API Keys).
OPENROUTER_API_KEY=

# (Backward compat) OPENAI_API_KEY is also checked as a fallback if
# OPENROUTER_API_KEY is not set.
OPENAI_API_KEY=

# Base URL for the LLM provider (OpenAI-compatible).
# Defaults to the OpenRouter endpoint (https://openrouter.ai/api/v1).
# Set this only if you need a different provider.
OPENAI_BASE_URL=

# Force stub mode for RAG generation regardless of API keys.
# Set to 'true' to guarantee deterministic, offline-safe responses.
RAG_USE_STUB_LLM=true

# Qdrant vector-search endpoint. Leave empty if Agent A hasn't provisioned
# the collection yet (DenseRetriever degrades gracefully).
# Local/self-hosted:  http://localhost:6333
# Qdrant Cloud:       https://<cluster-id>.<region>.aws.cloud.qdrant.io:6333
#   (free tier: 1 node, 0.5 vCPU / 1 GB RAM / 4 GB disk — holds ~1M 768-dim
#    vectors; this corpus is ~13K chunks / ~40 MB, well within free limits.
#    Free clusters auto-suspend after ~1 week idle, delete after ~4 weeks.)
RAG_QDRANT_URL=

# Qdrant Cloud API key (required for Qdrant Cloud managed instances).
# Leave empty for local/self-hosted Qdrant without authentication.
# Generate from cloud.qdrant.io → your cluster → API Keys.
RAG_QDRANT_API_KEY=

# Qdrant collection name (must match Agent A's index).
RAG_QDRANT_COLLECTION=fssai_legal_768

# Vector dimensionality — must match the embedding model used by Agent A.
# Keep 768 for sentence-transformers/all-mpnet-base-v2. If you switch to
# Qdrant Cloud's hosted inference models (Mode B), recreate the collection at
# THAT model's size (e.g. 384 for all-MiniLM-L6-v2) or retrieval breaks.
RAG_VECTOR_SIZE=768

# Embedding model for query encoding — MUST match Agent A's corpus-embedding model.
# Local embeddings (recommended): sentence-transformers/all-mpnet-base-v2 (768-dim).
# Qdrant Cloud inference alternative (requires pipeline code changes): pick a
# hosted FastEmbed model whose dims match RAG_VECTOR_SIZE.
RAG_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2

# BM25 sparse (hybrid) retrieval — local fastembed vectors, no Qdrant hosted
# inference required.  When 'true', NEW collections are created with a named
# sparse vector ('text_sparse', IDF) and ingestion also embeds sparse vectors.
# Existing dense-only collections keep working (dense-only) until recreated;
# to enable BM25 on the production index: drop/recreate the collection, then
# re-run ingestion.
RAG_ENABLE_SPARSE=true
# fastembed sparse model (BM25).
RAG_SPARSE_MODEL=Qdrant/bm25

# Cross-encoder reranker model (requires sentence-transformers + torch).
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Full Phase 2 enrichment on production ingestion (Agent A Days 6-9).
# Set to 'true' to wire MetadataAdapter + CitationAdapter + CrossRefAdapter
# + ChunkQualityValidator into the ingestion pipeline in addition to the
# always-on DocumentClassifier (document metadata, per-chunk citations /
# references, and quality summaries). Default 'false' — classifier only.
RAG_FULL_ENRICHMENT=true

# QStash-scheduled daily corpus ingestion (Agent A Phase 1, Day 4).
# Set to 'true' AND point RAG_CORPUS_DIR at a directory of PDF/DOCX/TXT
# corpus files to register a daily QStash schedule dispatching
# rag.ingest_corpus_task. Requires QStash credentials (paid plan); otherwise
# the schedule registration degrades to {"mode": "disabled"}.
RAG_ENABLE_INGESTION_SCHEDULE=false
RAG_CORPUS_DIR=
# Cron expression for the daily ingestion (default: daily 03:00 UTC).
RAG_INGESTION_CRON=0 3 * * *

# ---------------------------------------------------------------------------
# Neo4j Aura — Knowledge Graph (Phase 14 optional sync)
# ---------------------------------------------------------------------------
# Set these to enable the `POST /knowledge-graph/api/sync-neo4j` endpoint.
# The neo4j Python driver pushes local entity/relationship rows to your
# Aura instance using APOC dynamic labels (Case, FBO, Section, etc.).
# Leave blank to keep Neo4j sync dormant (app boots normally without it).
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
# Port the WSGI server listens on (Render defaults to 10000)
PORT=8000
