# =============================================================================
# NSA Webservice — Environment Variable Reference
# =============================================================================
# Copy this file to .env and fill in your local development values.
# Never commit .env to version control.
#
# For Render production, set each variable via the Render Dashboard.
# See render.yaml for the base service definition.
# =============================================================================

# ---------------------------------------------------------------------------
# Flask
# ---------------------------------------------------------------------------
# Generate a secure random key:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret-key

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL (production): postgresql://user:password@host:5432/nsa_db
# SQLite   (local dev):    sqlite:////absolute/path/to/app.db  (or omit to use default)
DATABASE_URL=

# ---------------------------------------------------------------------------
# Redis / Celery
# ---------------------------------------------------------------------------
# Local dev default: redis://localhost:6379/0
# Render / production: rediss://user:password@host:6379
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Airtable Sync (Multi-Target Sheets Redundancy — Priority 7)
# ---------------------------------------------------------------------------
# Airtable personal access token from https://airtable.com/create/tokens
# Required scopes: data.records:write, data.records:read
# Optional (base rotation): schema.bases:read, schema.bases:write
AIRTABLE_API_KEY=your-airtable-personal-access-token-here

# Primary Airtable base ID (starts with "app" — find in airtable.com URL)
AIRTABLE_BASE_ID=your-airtable-base-id-here

# Feature flag — set to "true" to enable Airtable sync (app/services/airtable_sync.py).
# Set to "false" (or leave unset) to keep Airtable dormant.
ENABLE_AIRTABLE_SYNC=true

# ---------------------------------------------------------------------------
# Microsoft Excel Online Sync (Multi-Target Sheets Redundancy — Priority 7)
# ---------------------------------------------------------------------------
# Azure AD app registration (app-only / client credentials flow) with
# Files.ReadWrite.All application permission granted admin consent.
# Create at https://portal.azure.com → Azure Active Directory → App registrations.
MS_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MS_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MS_CLIENT_SECRET=your-client-secret-here
# The OneDrive/SharePoint drive item ID of the Excel workbook.
# Find via: https://graph.microsoft.com/v1.0/drives/{MS_DRIVE_ID}/root/children
MS_DRIVE_ID=
MS_SPREADSHEET_ID=your-excel-spreadsheet-id-here
# Feature flag — set to "true" once Microsoft 365 credentials are available.
# Currently dormant (ENABLE_EXCEL_SYNC=false) — MS Excel Online sync off.
ENABLE_EXCEL_SYNC=false

# ---------------------------------------------------------------------------
# Google Sheets Sync
# ---------------------------------------------------------------------------
# The full JSON content of the Google service-account credential file,
# pasted as a single-line or multi-line string (gspread parses it).
# Example:  GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":...}
GOOGLE_CREDENTIALS_JSON=

# The ID (long hex string) of the Google Spreadsheet to sync with.
SPREADSHEET_ID=

# ---------------------------------------------------------------------------
# S3-Compatible Storage (Cloudflare R2 / Backblaze B2)
# ---------------------------------------------------------------------------
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_ENDPOINT=

# Optional region override (defaults to 'auto' for R2)
R2_REGION=auto

# Optional custom public domain (e.g. https://media.example.com)
R2_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Full-ZIP backup snapshots to R2 (Multi-Target Sheets Redundancy — Priority 7)
# ---------------------------------------------------------------------------
# When true (default), every backup run (daily QStash schedule at 02:00 UTC or
# POST /settings/backup-redundant-to-r2) also uploads a full backup ZIP —
# complete database dump + instance files — to
# s3://<R2_BUCKET>/nsa_backups/full_archives/. Requires the R2_* variables
# above. Opt-out convention: set to "false" to disable.
BACKUP_FULL_ARCHIVE_ENABLED=true

# How many recent full-archive ZIPs to keep in R2 (older ones are deleted
# after each successful upload).
BACKUP_ARCHIVE_RETENTION=30

# When true, a freshly-provisioned (empty) database replenishes itself at
# boot: the newest full-archive ZIP in R2 is restored first (complete
# fidelity); if none exists, the Airtable→Excel→Sheets CSV chain is tried.
# Requires the R2_* variables above. Default false (opt-in).
AUTO_RESTORE_ON_EMPTY_DB=false

# ---------------------------------------------------------------------------
# Cloudinary (photo upload & management)
# ---------------------------------------------------------------------------
# Credentials from https://console.cloudinary.com/  →  API Keys tab.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# The python-cloudinary SDK also accepts the combined form (optional):
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ---------------------------------------------------------------------------
# PDF Generation
# ---------------------------------------------------------------------------
# Set to 'true' to disable PDF generation (useful on systems without GTK)
DISABLE_PDF_GENERATION=false

# Set to 'true' to embed photo URLs directly instead of base64 data URIs
PDF_USE_DIRECT_URLS=false

# ---------------------------------------------------------------------------
# Upstash QStash (serverless task queue — no background worker required)
# ---------------------------------------------------------------------------
# QStash delivers task messages to your public webhook URL, so heavy work
# (PDF generation) can run without a persistent Celery worker.
# Get credentials from https://console.upstash.com/qstash
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Public base URL of this app (used to construct the webhook URL QStash POSTs to)
# e.g. https://food-adjudication-portal.onrender.com
PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Startup Behaviour
# ---------------------------------------------------------------------------
# Set to '1' to skip the FSO sync on startup (useful during fresh-DB migrations)
SKIP_FSO_STARTUP_SYNC=

# ---------------------------------------------------------------------------
# Plugin Architecture (Phase 20)
# ---------------------------------------------------------------------------
# Provider selection for the plugin registry (app/plugins/). Each provider
# is selected via Flask config at call-time, mirroring the RAG feature-flag
# pattern. Defaults are registered automatically; set to 'none' to disable.
# OCR provider: 'easyocr' (default), 'paddleocr', or 'tesseract'
OCR_PROVIDER=easyocr
# Comma-separated languages for the active OCR provider (default 'english,hindi')
OCR_LANGUAGES=english,hindi
# GPU for OCR inference — false = CPU (keep false on Render free tier)
OCR_USE_GPU=false
# AI provider: 'openrouter' (default) or 'openai'
AI_PROVIDER=openrouter
# Rule provider: 'fssai_default' (default)
RULES_PROVIDER=fssai_default
# PDF provider: 'weasyprint' (default)
PDF_PROVIDER=weasyprint

# AI Assistant (Phase 11)
# ---------------------------------------------------------------------------
# LLM provider: 'openrouter' (default) or 'openai'.
# When unset or empty, the AI assistant is dormant (routes return 503).
AI_ASSISTANT_PROVIDER=openrouter

# API key for the selected provider.
# Get from https://openrouter.ai/ (API Keys) or https://platform.openai.com/ (API keys).
AI_ASSISTANT_API_KEY=

# Optional override for the API base URL (e.g. for a proxy or self-hosted model).
# Defaults to https://openrouter.ai/api/v1 or https://api.openai.com/v1.
AI_ASSISTANT_BASE_URL=

# Optional model override.
# Defaults to 'poolside/laguna-s-2.1:free' (OpenRouter) or 'gpt-4o-mini' (OpenAI).
AI_ASSISTANT_MODEL=

# ---------------------------------------------------------------------------
# Phase B: RAG (FSSAI Legal RAG System — Agent B)
# ---------------------------------------------------------------------------
# Set to 'false' to disable the RAG module entirely (routes return 503).
RAG_ENABLED=true

# LLM model for grounded RAG generation (Agent B Phase 2+).
# Defaults to 'poolside/laguna-s-2.1:free' (OpenRouter free tier).
# The RAG_LLM_MODEL env var overrides the default.
# Set to any OpenAI-compatible model slug.
RAG_LLM_MODEL=poolside/laguna-s-2.1:free

# API key for the LLM provider (OpenAI-compatible).
# Get from https://openrouter.ai/ (API Keys).
OPENROUTER_API_KEY=

# (Backward compat) OPENAI_API_KEY is also checked as a fallback if
# OPENROUTER_API_KEY is not set.
OPENAI_API_KEY=

# Base URL for the LLM provider (OpenAI-compatible).
# Defaults to the OpenRouter endpoint (https://openrouter.ai/api/v1).
# Set this only if you need a different provider.
OPENAI_BASE_URL=

# Force stub mode for RAG generation regardless of API keys.
# Set to 'true' to guarantee deterministic, offline-safe responses.
RAG_USE_STUB_LLM=true

# Qdrant vector-search endpoint. Leave empty if Agent A hasn't provisioned
# the collection yet (DenseRetriever degrades gracefully).
# Local/self-hosted:  http://localhost:6333
# Qdrant Cloud:       https://<cluster-id>.<region>.aws.cloud.qdrant.io:6333
#   (free tier: 1 node, 0.5 vCPU / 1 GB RAM / 4 GB disk — holds ~1M 768-dim
#    vectors; this corpus is ~13K chunks / ~40 MB, well within free limits.
#    Free clusters auto-suspend after ~1 week idle, delete after ~4 weeks.)
RAG_QDRANT_URL=

# Qdrant Cloud API key (required for Qdrant Cloud managed instances).
# Leave empty for local/self-hosted Qdrant without authentication.
# Generate from cloud.qdrant.io → your cluster → API Keys.
RAG_QDRANT_API_KEY=

# Qdrant collection name (must match Agent A's index).
RAG_QDRANT_COLLECTION=fssai_legal_768

# Vector dimensionality — must match the embedding model used by Agent A.
# Keep 768 for sentence-transformers/all-mpnet-base-v2. If you switch to
# Qdrant Cloud's hosted inference models (Mode B), recreate the collection at
# THAT model's size (e.g. 384 for all-MiniLM-L6-v2) or retrieval breaks.
RAG_VECTOR_SIZE=768

# Embedding model for query encoding — MUST match Agent A's corpus-embedding model.
# Local embeddings (recommended): sentence-transformers/all-mpnet-base-v2 (768-dim).
# Qdrant Cloud inference alternative (requires pipeline code changes): pick a
# hosted FastEmbed model whose dims match RAG_VECTOR_SIZE.
RAG_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2

# BM25 sparse (hybrid) retrieval — local fastembed vectors, no Qdrant hosted
# inference required.  When 'true', NEW collections are created with a named
# sparse vector ('text_sparse', IDF) and ingestion also embeds sparse vectors.
# Existing dense-only collections keep working (dense-only) until recreated;
# to enable BM25 on the production index: drop/recreate the collection, then
# re-run ingestion.
RAG_ENABLE_SPARSE=true
# fastembed sparse model (BM25).
RAG_SPARSE_MODEL=Qdrant/bm25

# Cross-encoder reranker model (requires sentence-transformers + torch).
# The fine-tuned legal CE (CE_RERANK_REVIEW 2026-08-14) is a validated drop-in
# — train with `python -m evaluation.finetune_ce`, then point here:
#   RAG_RERANKER_MODEL=evaluation/out/models/legal_ce_v1
# (path relative to the project root; ship the weights to the host, or keep
# the base ms-marco model — the EnsembleReranker degrades to features-only
# when the path/model is unavailable).
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Full Phase 2 enrichment on production ingestion (Agent A Days 6-9).
# Set to 'true' to wire MetadataAdapter + CitationAdapter + CrossRefAdapter
# + ChunkQualityValidator into the ingestion pipeline in addition to the
# always-on DocumentClassifier (document metadata, per-chunk citations /
# references, and quality summaries). Default 'false' — classifier only.
RAG_FULL_ENRICHMENT=true

# QStash-scheduled daily corpus ingestion (Agent A Phase 1, Day 4).
# Set to 'true' AND point RAG_CORPUS_DIR at a directory of PDF/DOCX/TXT
# corpus files to register a daily QStash schedule dispatching
# rag.ingest_corpus_task. Requires QStash credentials (paid plan); otherwise
# the schedule registration degrades to {"mode": "disabled"}.
RAG_ENABLE_INGESTION_SCHEDULE=false
RAG_CORPUS_DIR=
# Cron expression for the daily ingestion (default: daily 03:00 UTC).
RAG_INGESTION_CRON=0 3 * * *

# KG graph expansion in the generation pipeline (2026-08-12): expand the
# retrieved chunk IDs through the Neo4j legal KG and inject the provisions
# as extra [Source n] blocks. Best-effort — a missing/unreachable Neo4j
# degrades to no expansion. Default 'false'.
RAG_KG_EXPANSION=false

# KG retrieval-contract fusion (2026-08-12): run the graph-RAG query->
# provisions contract and RRF-fuse those provisions into the ranked context
# alongside the retrieved chunks (production equivalent of evaluation arm G,
# which showed a significant Recall@10 gain over tail-concatenation).
# Best-effort — a missing/unreachable Neo4j degrades to no fusion.
# Default 'false'.
RAG_KG_FUSION=false

# Max KG provisions injected into the LLM context (each provision takes one
# context slot, displacing the tail of retrieved chunks). Default 5.
RAG_KG_MAX_PROVISIONS=5

# Legal-identifier route (2026-08-13): when a query names an Act and/or
# section number, run a lexical "{Act} section {N}" query through the sparse
# retriever as a parallel additive arm fused with dense+sparse RRF. Validated
# by the V5/V5.5 evaluation arc (+13.3pp candidate-pool ceiling; pool 100%
# after the section-stamp backfill). Default 'true' — pure lexical retrieval,
# no external dependency. Set to 'false' to disable.
RAG_IDENTIFIER_ROUTE=true

# sec_act + cross-encoder ensemble reranker (2026-08-14, CE_RERANK_REVIEW):
# when 'true' (default), retrieval ranking uses the deterministic sec_act
# legal features as primary (query-detected section/Act vs payload stamps —
# the strongest single reranker measured, R@10 0.474 on the P1 head) with
# the cross-encoder scored only on the post-sec_act top-K head as a
# complementary second opinion (union any-hit R@10 62.0% vs 56.7% alone).
# The deterministic half needs no external dependency; the CE half degrades
# to features-only when sentence-transformers is unavailable. Set to 'false'
# for the plain (cross-encoder-or-BM25) Reranker.
RAG_ENSEMBLE_RERANK=true
# How many post-sec_act chunks the cross-encoder scores (latency bound).
RAG_ENSEMBLE_CE_HEAD=30
# Bonus weight applied to the min-max-normalized CE scores on the head.
RAG_ENSEMBLE_CE_WEIGHT=0.5
# Remote cross-encoder hosting (TEI /rerank endpoint, HF Docker Space or
# Inference Endpoint — docs/HF_HOSTING_LANGGRAPH_INTEGRATION_PLAN.md Part B).
# When set, the CE head is scored over HTTP instead of a local torch model;
# the sec_act features stay local. Empty = local CE as before.
RAG_RERANKER_ENDPOINT=
# Bearer token for the endpoint (required for private Spaces / Inference
# Endpoints / the Serverless Inference API).
RAG_RERANKER_TOKEN=
# Backend: 'tei' (default — TEI /rerank, one batched POST per query) or
# 'serverless' (HF Serverless Inference API — per-pair [SEP] requests, free
# tier, no Docker Space / Endpoint needed; e.g.
# RAG_RERANKER_ENDPOINT=https://api-inference.huggingface.co/models/<repo>).
RAG_RERANKER_MODE=tei
# Per-request timeout (seconds) for the /rerank call.
RAG_RERANKER_TIMEOUT=5
# Fall back to the local CE (lazy, built on first remote failure) when the
# endpoint errors. False = remote failure degrades to sec_act features-only.
RAG_RERANKER_REMOTE_FALLBACK=true
# Remote dense-embedding hosting (Modal / TEI-style /embed — see
# app/rag/retrieval/remote_embedder.py). When set, DenseRetriever embeds
# queries over HTTP instead of loading all-mpnet-base-v2 + torch locally
# (Render free tier cannot hold them). Empty = local encoder as before.
# Ingestion-side embedding stays local (one-off scripts, not on Render).
RAG_EMBED_ENDPOINT=
# Bearer token for the embed endpoint, if it requires one.
RAG_EMBED_TOKEN=
# Per-request timeout (seconds) for the /embed call.
RAG_EMBED_TIMEOUT=5
# Fall back to a local SentenceTransformer (lazy) when the remote embedder
# errors. False = remote failure degrades to sparse-only — REQUIRED on
# Render free tier (a local torch build would OOM the 512 MB instance).
RAG_EMBED_REMOTE_FALLBACK=true
# Qdrant-side BM25 (server-side sparse inference, Qdrant/bm25): when on, the
# sparse retriever sends the raw query text and the cluster computes the BM25
# vector in-cluster — no local fastembed at query time (the last local model
# on Render disappears). Requires qdrant-client >= 1.12 + a collection whose
# text_sparse vector has modifier: idf (both true for fssai_legal_768).
RAG_QDRANT_BM25=false
# LangGraph agent pipeline (docs/HF_HOSTING_LANGGRAPH_INTEGRATION_PLAN.md
# Part C): when true, POST /api/rag/query/agent runs the self-correcting
# graph (classify -> retrieve -> generate -> verify -> expand-and-retry on
# low groundedness). Default false — the endpoint delegates to the legacy
# pipeline, and /api/rag/query is never affected. Requires langgraph.
RAG_USE_AGENT_PIPELINE=false
# Phase 3 claim-level hallucination detection in the live generation pipeline.
RAG_HALLUCINATION_DETECTOR=true
# M5 human-in-the-loop (LangGraph): when true, the agent graph pauses at a
# review interrupt before finalize — POST /api/rag/query/agent returns 202
# awaiting_review, and POST /api/rag/query/agent/resume takes {thread_id,
# approved}. Default false (graph runs end-to-end). Requires a checkpointer.
RAG_AGENT_HITL=false
# M5 checkpointer: 'memory' (default — MemorySaver, in-process, dev/tests)
# or 'postgres' (PostgresSaver against DATABASE_URL; requires
# langgraph-checkpoint-postgres + psycopg-binary).
RAG_AGENT_CHECKPOINTER=memory
# ---------------------------------------------------------------------------
# FastAPI Gateway (asgi.py)
# ---------------------------------------------------------------------------
# Optional API key for /api/v2/* endpoints (FastAPI ASGI gateway). When unset,
# /api/v2/* is open (dev mode). Set for production auth via x-api-key header.
API_V2_KEY=
# Query-type-aware reranking (CE_RERANK_REVIEW, STEP 7): classifies queries
# into legal types (prohibition, authority, cross-reference, offence) and
# applies per-type weight overrides. Default true.
RAG_LEGAL_QUERY_TYPING=true
# CE section-prefix for legal-identity signal (CV2 P1, 2026-08-18).
# When 'true', the cross-encoder reranker prefixes each passage with its
# legal identity (§<section> or §<clause>) before scoring — matching the
# training data format from `evaluation/pairwise_dataset --section-prefix`.
# Default 'false' (zero behaviour change for v1 / unprefixed models).
# Toggle independently: --section-prefix controls training, this flag
# controls what the served model receives (the two are independent).
RAG_CE_SECTION_PREFIX=false

# Torch thread cap for RAG inference (dense embedding + CE reranking).
# PyTorch defaults to one thread per logical core, which on laptops pegs
# every core during a single query (freezing the machine). 4 threads is the
# measured sweet spot (i5-1135G7 / 8 GB class) — both faster than the
# 8-thread default AND leaves the laptop usable mid-query. Default 4.
RAG_TORCH_THREADS=4

# ---------------------------------------------------------------------------
# Neo4j Aura — Knowledge Graph (Phase 14 optional sync)
# ---------------------------------------------------------------------------
# Set these to enable the `POST /knowledge-graph/api/sync-neo4j` endpoint.
# The neo4j Python driver pushes local entity/relationship rows to your
# Aura instance using APOC dynamic labels (Case, FBO, Section, etc.).
# Leave blank to keep Neo4j sync dormant (app boots normally without it).
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# Fail-closed write guard (added 2026-08-12): destructive Neo4j operations —
# push_to_neo4j (clears the WHOLE graph with MATCH (n) DETACH DELETE n),
# clear_legal_kg (legal-KG rebuild), and neo4j_aura_loader — REFUSE to run
# unless NEO4J_ALLOW_WRITE=1 is set. Leave unset in CI/test environments;
# set only when you deliberately intend to write to (or rebuild) the live KG:
#   NEO4J_ALLOW_WRITE=1 python scripts/build_kg_corpus.py
NEO4J_ALLOW_WRITE=

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
# Port the WSGI server listens on (Render defaults to 10000)
PORT=8000

# Daily QStash backup schedule (Priority 7 redundancy) - opt-in
ENABLE_BACKUP_SCHEDULE=false

# ---------------------------------------------------------------------------
# Phase 17: Supabase Cloud Sync Bridge
# ---------------------------------------------------------------------------
# Feature flag — set to 'true' to enable the Supabase sync bridge.
# When disabled, all /sync/* routes return 503 and no network activity occurs.
ENABLE_SUPABASE_SYNC=false

# Supabase project URL — found at https://supabase.com/dashboard → your project →
# Settings → API → "Project URL".
SUPABASE_URL=

# Supabase anon or service_role key — from https://supabase.com/dashboard →
# your project → Settings → API → "API keys".
SUPABASE_API_KEY=

# Polling interval (seconds) for automatic sync operations. Default 300 (5 min).
SUPABASE_SYNC_INTERVAL=300
